<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net461;net10.0</TargetFrameworks>
    <AssemblyName>JBOpale.MathAdvanced</AssemblyName>
    <RootNamespace>JBOPaleAPI</RootNamespace>
    <Deterministic>true</Deterministic>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- NuGet metadata (remplace le .nuspec) -->
    <PackageId>JBOpale.MathAdvanced</PackageId>
    <Version>2.0.0</Version>
    <Authors>Jérôme FRANCOIS, JB-OPale Teams</Authors>
    <Company>JBOPale</Company>
    <Copyright>Copyright (C) 2026 JB-OPale</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/JBOpale/MathAdvanced.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Description>Ensemble de méthodes et de classes mathématiques</Description>
    <PackageTags>JB-OPale Extensions Math MathAdvanced</PackageTags>
    <PackageProjectUrl>https://github.com/JBOpale/MathAdvanced</PackageProjectUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <!-- Nullable uniquement pour net10 -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net461'">
    <Nullable>enable</Nullable>
    <LangVersion>8.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    <None Update="package\skills\jbopale-mathadvanced\SKILL.md" Pack="true" PackagePath="skills\jbopale-mathadvanced\" />
  </ItemGroup>

</Project>