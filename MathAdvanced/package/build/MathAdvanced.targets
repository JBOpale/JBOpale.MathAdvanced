<Project>

  <!--
    Installe le skill Claude livré avec le paquet dans le projet qui le référence :
    <projet>/.claude/skills/mathadvanced/SKILL.md (écrasé à chaque mise à jour du paquet).
    Désactivation : <MathAdvancedInstallClaudeSkill>false</MathAdvancedInstallClaudeSkill>
    dans le .csproj consommateur.
  -->
  <PropertyGroup>
    <MathAdvancedInstallClaudeSkill Condition="'$(MathAdvancedInstallClaudeSkill)' == ''">true</MathAdvancedInstallClaudeSkill>
  </PropertyGroup>

  <Target Name="MathAdvancedCopyClaudeSkill"
          BeforeTargets="BeforeBuild"
          Condition="'$(MathAdvancedInstallClaudeSkill)' == 'true'">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\skills\mathadvanced\SKILL.md"
          DestinationFolder="$(MSBuildProjectDirectory)\.claude\skills\mathadvanced"
          SkipUnchangedFiles="true"
          ContinueOnError="true" />
  </Target>

</Project>
